      <score-instrument id="P5-I38"><instrument-name>Snare</instrument-name></score-instrument>
      <midi-instrument id="P5-I36"><midi-channel>10</midi-channel><midi-program>1</midi-program><midi-unpitched>37</midi-unpitched></midi-instrument>
