<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Synthetic, song-neutral ensemble fixture for tools/score-import.mjs (written for
  this repo; no third-party material). Concert key C major, 4/4, 6 bars,
  rehearsal marks A (bar 1) and B (bar 5). Each part exists to trip one hazard:

  P1 B-flat clarinet  written a tone ABOVE concert (<transpose> -2). Sounding line
                      E4 F4 G4 A4 | G4 (half, tied to a quarter) F4 | E4 D4 C4 | rests.
                      Bar 2 voice 2 enters by <backup>/<forward> on beat 3 (hazard 1,
                      the r.256 placeholder) an octave under voice 1 (close same-staff
                      divisi would read as transcription fragmentation in a 6-bar
                      sample), and the tie in bar 2 is on a transposed part (hazard 3,
                      the tie-before-transpose link).
  P2 Flute            carries section B, with a two-eighth pickup at the end of bar 4
                      (the clarinet span's last bar — span edges must move).
  P3 Piano            a whole-note C-E-G chord ABOVE the clarinet in every bar: the
                      register heuristic picks it; source-roles must not.
  P4 Guitar           written an octave above sounding (<octave-change>-1), with a
                      tie inside bar 2 and one across the 3|4 barline (hazard 3).
  P5 Drums            a two-instrument kit (GM 36, 38) defined by the score (hazard:
                      the AlphaTex exporter names every hit "Snare (hit)").
-->
<score-partwise version="3.1">
  <work><work-title>Ensemble Fixture</work-title></work>
  <part-list>
    <score-part id="P1">
      <part-name>Clarinet in Bb</part-name>
      <score-instrument id="P1-I1"><instrument-name>Clarinet in Bb</instrument-name></score-instrument>
      <midi-instrument id="P1-I1"><midi-channel>1</midi-channel><midi-program>72</midi-program></midi-instrument>
    </score-part>
    <score-part id="P2">
      <part-name>Flute</part-name>
      <score-instrument id="P2-I1"><instrument-name>Flute</instrument-name></score-instrument>
      <midi-instrument id="P2-I1"><midi-channel>2</midi-channel><midi-program>74</midi-program></midi-instrument>
    </score-part>
    <score-part id="P3">
      <part-name>Piano</part-name>
      <score-instrument id="P3-I1"><instrument-name>Piano</instrument-name></score-instrument>
      <midi-instrument id="P3-I1"><midi-channel>3</midi-channel><midi-program>1</midi-program></midi-instrument>
