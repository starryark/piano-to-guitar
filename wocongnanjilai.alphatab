\track ("Electric Piano" "el.pno.") {
  volume 15
  balance 8
  instrument acousticgrandpiano
}
  \staff {
    score
  }
    \ts (4 4)
    \tempo 120
    \accidentals auto
    \clef g2
    \ottava regular
    \simile none
    \ks aminor
      r.4{dy f instrument acousticgrandpiano}
